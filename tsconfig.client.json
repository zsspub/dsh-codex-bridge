{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "react"
    ],
    "noEmit": false,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/protocol.ts"
  ]
}
